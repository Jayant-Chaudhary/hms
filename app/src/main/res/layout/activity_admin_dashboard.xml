            <LinearLayout
                android:id="@+id/navTabAnalytics"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_admin_nav_unselected"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navIconAnalytics"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvNavAnalytics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_nav_analytics"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navTabRooms"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_admin_nav_selected"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navIconRooms"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/tvNavRooms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_nav_rooms"
                    android:textColor="@color/primary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navTabAccess"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_admin_nav_unselected"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navIconAccess"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_manage"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvNavAccess"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_nav_access"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
