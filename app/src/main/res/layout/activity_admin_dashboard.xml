                <TextView
                    android:id="@+id/tvNavFinance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_nav_finance"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
