<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_dashboard_card">

    <TextView
        android:id="@+id/tvTxnIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="₹"
        android:textStyle="bold"
        android:textColor="#5E35B1"
        android:textSize="18sp"
        android:background="@drawable/bg_white_card" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTxnTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textColor="#1A1A2E"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Room Booking" />

            <TextView
                android:id="@+id/tvTxnAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:textSize="14sp"
                android:text="+₹0" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTxnSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#555555"
            android:textSize="12sp"
            android:text="Oct 24 • UPI" />

        <TextView
            android:id="@+id/tvTxnNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#777777"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Booking payment" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnEdit"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Edit"
                android:textSize="12sp"
                android:background="@drawable/rounded_button_outline"
                android:textColor="#1565C0" />

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:text="Delete"
                android:textSize="12sp"
                android:background="@drawable/rounded_button_outline"
                android:textColor="#B00020" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

