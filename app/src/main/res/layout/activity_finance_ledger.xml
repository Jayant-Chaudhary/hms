<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_gradient"
    android:padding="14dp">

    <TextView
        android:id="@+id/btnBackLedger"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:padding="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvLedgerTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ledger"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@id/btnBackLedger"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etSearchLedger"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:hint="Search transaction reason / remark…"
        android:background="@drawable/rounded_edittext"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnBackLedger"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupLedgerType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:layout_constraintTop_toBottomOf="@id/etSearchLedger"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/spinnerLedgerSort">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipLedgerAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="All"
            android:checked="true"
            app:chipBackgroundColor="@color/surface"
            app:chipStrokeColor="@color/primary"
            app:chipStrokeWidth="1dp"
            android:textColor="@color/text_primary" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipLedgerRevenue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="Revenue"
            app:chipBackgroundColor="@color/surface"
            app:chipStrokeColor="@color/primary"
            app:chipStrokeWidth="1dp"
            android:textColor="@color/text_primary" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipLedgerExpense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="Expenses"
            app:chipBackgroundColor="@color/surface"
            app:chipStrokeColor="@color/primary"
            app:chipStrokeWidth="1dp"
            android:textColor="@color/text_primary" />
    </com.google.android.material.chip.ChipGroup>

    <Spinner
        android:id="@+id/spinnerLedgerSort"
        android:layout_width="140dp"
        android:layout_height="48dp"
        android:background="@drawable/rounded_edittext"
        app:layout_constraintTop_toTopOf="@id/chipGroupLedgerType"
        app:layout_constraintBottom_toBottomOf="@id/chipGroupLedgerType"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/includeLedgerHeader"
        layout="@layout/item_ledger_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/chipGroupLedgerType"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLedger"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/includeLedgerHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

